      }
    ]
  },
  "signature": {
    "key_id": "avp-dev-local",
    "alg": "ed25519",
    "sig": "E35A3NbeHAYGf96N0sD4ltEpOqFGLHPB788jHiiB0IsGaeERPkVk5ZHybRarekmoQHHrjTkRcqNMwuQIuEOfDQ=="
  }
