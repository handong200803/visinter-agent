{
  "schema": "ai-video-platform/plugin",
  "id": "fixture-exec-quarantine",
  "name": "声明 exec 的插件（selftest 用）",
  "version": "1.0.0",
  "type": "node",
  "description": "manifest 合法但声明了 exec：只登记为 needs-review，不注入运行时。",
  "engines": {
    "platform": ">=0.1.0"
  },
  "permissions": [
    "fs:read",
    "exec"
  ],
  "contributes": {
